<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\inetpub\PayRoll_ActionSpring\venv311\Scripts\python.exe|C:\inetpub\PayRoll_ActionSpring\venv311\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>
    <security>
      <requestFiltering allowDoubleEscaping="true" />
    </security>
  </system.webServer>

  <appSettings>
    <add key="WSGI_HANDLER" value="PayRoll.wsgi.application" />
    <add key="PYTHONPATH" value="C:\inetpub\PayRoll_ActionSpring\PayRoll" />
    <add key="DJANGO_SETTINGS_MODULE" value="PayRoll.settings" />
    <add key="SCRIPT_NAME" value="/Payroll" />
    <add key="WSGI_LOG" value="C:\inetpub\PayRoll_ActionSpring\PayRoll\logs\wfastcgi.log" />
  </appSettings>
</configuration>